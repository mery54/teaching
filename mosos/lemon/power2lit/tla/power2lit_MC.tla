---------------------------- MODULE power2lit_MC ----------------------------
(* Generated by eb2pcal from the Event-B machine F-ALGOPC (F-ALGOPC.bum) *)
EXTENDS Integers, FiniteSets, TLC

CONSTANTS L, n0, v, w, start, end_, r0, MaxInt

Nati == 0 .. MaxInt
Inti == -MaxInt .. MaxInt
def_v == [i \in Nati |-> i*i]
def_w == [i \in Nati |-> 2*i]
def_start == "start"
def_end == "end"
def_L == {"start", "end"}

(* Event-B operators *)
EB_Image(eb_r, eb_S) == {eb_r[eb_x] : eb_x \in eb_S \cap DOMAIN eb_r}
EB_IsPFun(eb_f, eb_A, eb_B) == DOMAIN eb_f \subseteq eb_A /\ \A eb_x \in DOMAIN eb_f : eb_f[eb_x] \in eb_B

(* Axioms and theorems of the seen contexts *)
ASSUME A_C0_pre1 == n0 \in Nati
ASSUME A_C0_pre2 == r0 \in Inti
ASSUME A_C0_axm3 == w[0] = 0
ASSUME A_C0_axm6 == v[0] = 0
ASSUME A_C0_axm8 == L = {start} \cup {end_} /\ {start} \cap {end_} = {}
ASSUME A_C0_axm11 == n0 >= 3

(* --fair algorithm power2lit_algo {
variables
  r = r0,
  k = 0,
  cv = 0,
  cw = 0,
  n = n0;
{
L_start:
  while (k < n) {
    k := k + 1 || cv := cv + cw + 1 || cw := cw + 2;
  };
L_start_exit:
  await k = n;
  r := cv;
}
}
*)

\* BEGIN TRANSLATION
\* END TRANSLATION

(* Invariants of the machines of the refinement chain *)
(* Refinement mapping: variables of the abstract machines that disappear
   along the chain, expressed on the state of the last machine *)
pc_ == CASE pc = "L_start" -> start [] pc = "L_start_exit" -> start [] pc = "Done" -> end_   \* program counter (control points)
ok == (~(pc_ = start))   \* F-ALGOPC.inv3
vv == [i \in 0 .. k |-> v[i]]   \* C-COMPUTING.inv6, C-COMPUTING.inv4
ww == [i \in 0 .. k |-> w[i]]   \* C-COMPUTING.inv7, C-COMPUTING.inv5

Inv_B_PREPOST ==
  /\ r \in Inti   \* B-PREPOST.inv1
  /\ n \in Inti   \* B-PREPOST.inv4
  /\ ok \in BOOLEAN   \* B-PREPOST.inv2
  /\ ok = TRUE => r = n0 * n0   \* B-PREPOST.inv3
  /\ n = n0   \* B-PREPOST.inv5

Inv_C_COMPUTING ==
  /\ EB_IsPFun(vv, Nati, Inti)   \* C-COMPUTING.inv1
  /\ EB_IsPFun(ww, Nati, Inti)   \* C-COMPUTING.inv2
  /\ k \in Nati   \* C-COMPUTING.inv3
  /\ \A i \in DOMAIN vv : vv[i] = v[i]   \* C-COMPUTING.inv4
  /\ \A i \in DOMAIN ww : ww[i] = w[i]   \* C-COMPUTING.inv5
  /\ DOMAIN vv = 0 .. k   \* C-COMPUTING.inv6
  /\ DOMAIN ww = 0 .. k   \* C-COMPUTING.inv7
  /\ k <= n   \* C-COMPUTING.inv8
  /\ \A i \in DOMAIN vv : vv[i] = i * i   \* C-COMPUTING.safe1 (theorem)
  /\ \A i \in DOMAIN ww : ww[i] = 2 * i   \* C-COMPUTING.safe2 (theorem)
  /\ k < n => ok = FALSE   \* C-COMPUTING.inv11

Inv_D_PREALGO ==
  /\ cv \in Inti   \* D-PREALGO.inv2
  /\ cv = vv[k]   \* D-PREALGO.inv5
  /\ cw \in Inti   \* D-PREALGO.inv6
  /\ cw = ww[k]   \* D-PREALGO.inv7
  /\ k \in 0 .. n   \* D-PREALGO.propk (theorem)
  /\ cw = 2 * k   \* D-PREALGO.thw (theorem)
  /\ cv = k * k   \* D-PREALGO.thv (theorem)
  /\ 4 * cv = cw * cw   \* D-PREALGO.thvw (theorem)

Inv_E_ALGO ==
  /\ cw = 2 * k   \* E-ALGO.th1 (theorem)
  /\ cv = k * k   \* E-ALGO.th2 (theorem)
  /\ 4 * cv = cw * cw   \* E-ALGO.inv1th3 (theorem)

Inv_F_ALGOPC ==
  /\ pc_ \in L   \* F-ALGOPC.inv1
  /\ pc_ = end_ => r = v[n]   \* F-ALGOPC.inv2
  /\ pc_ = start <=> ok = FALSE   \* F-ALGOPC.inv3
  /\ pc_ = end_ <=> ok = TRUE   \* F-ALGOPC.inv4
  /\ cw = 2 * k   \* F-ALGOPC.th1 (theorem)
  /\ cv = k * k   \* F-ALGOPC.th2 (theorem)
  /\ 4 * cv = cw * cw   \* F-ALGOPC.th3 (theorem)

Inv ==
  /\ Inv_B_PREPOST
  /\ Inv_C_COMPUTING
  /\ Inv_D_PREALGO
  /\ Inv_E_ALGO
  /\ Inv_F_ALGOPC

(* No postcondition: no event of the first machine defines the result *)

======================================================================
