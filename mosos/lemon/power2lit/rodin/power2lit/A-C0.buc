    <org.eventb.core.axiom name="internal_e18" org.eventb.core.label="axm10" org.eventb.core.predicate="s ∈ ℕ → ℕ ∧ (∀ i · i ∈ ℕ ⇒ s(i) = i + 1)"/>
    <org.eventb.core.axiom name="internal_e19" org.eventb.core.label="axm9" org.eventb.core.predicate="∀ A · A ⊆ ℕ ∧ 0 ∈ A ∧ s[A] ⊆ A ⇒ ℕ ⊆ A"/>
    <org.eventb.core.axiom name="internal_e20" org.eventb.core.label="th1" org.eventb.core.predicate="∀ n · n ∈ ℕ ⇒ w(n) = 2 ∗ n" org.eventb.core.theorem="true"/>
    <org.eventb.core.axiom name="internal_e21" org.eventb.core.label="th2" org.eventb.core.predicate="∀ n · n ∈ ℕ ⇒ v(n) = n ∗ n" org.eventb.core.theorem="true"/>
