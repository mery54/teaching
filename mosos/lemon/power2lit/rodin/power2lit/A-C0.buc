    <org.eventb.core.axiom name="internal_e9" org.eventb.core.label="pre1" org.eventb.core.predicate="n0 ∈ ℕ" org.eventb.core.comment="precondition [FUN-1]"/>
    <org.eventb.core.axiom name="internal_e10" org.eventb.core.label="pre2" org.eventb.core.predicate="r0 ∈ ℤ"/>
    <org.eventb.core.axiom name="internal_e11" org.eventb.core.label="axm2" org.eventb.core.predicate="w ∈ ℕ → ℤ"/>
    <org.eventb.core.axiom name="internal_e12" org.eventb.core.label="axm3" org.eventb.core.predicate="w(0) = 0"/>
    <org.eventb.core.axiom name="internal_e13" org.eventb.core.label="axm4" org.eventb.core.predicate="∀ n · n ∈ ℕ ⇒ w(n + 1) = w(n) + 2"/>
    <org.eventb.core.axiom name="internal_e14" org.eventb.core.label="axm5" org.eventb.core.predicate="v ∈ ℕ → ℤ"/>
    <org.eventb.core.axiom name="internal_e15" org.eventb.core.label="axm6" org.eventb.core.predicate="v(0) = 0"/>
