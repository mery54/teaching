/* E-ALGO: extracted from the literate model power2lit.tex
*/
/* E-ALGO: generated by rodin2ab from the Rodin machine E-ALGO */
REFINEMENT E-ALGO
REFINES D-PREALGO
SEES
    A-C0
ABSTRACT_VARIABLES
    rr,
    kk,
    cv,
    cw,
    ok,
    nn
ASSERTIONS
    /* th1 */
    cw = (2 * kk) &
    /* th2 */
    cv = (kk * kk) &
    /* inv1th3 */
    (4 * cv) = (cw * cw)
VARIANT
    nn - kk
INITIALISATION
        rr := r0 ||
        kk := 0 ||
        cv := 0 ||
        cw := 0 ||
        ok := FALSE ||
        nn := n0
EVENTS
    computing =
    SELECT
        /* grd1 */
        kk = nn &
        /* grd2 */
        ok = FALSE
    THEN
        rr := cv ||
        ok := TRUE
    END;

    /* step: convergent event */
    step =
    SELECT
        /* grd1 */
        kk < nn &
        /* grd2 */
        ok = FALSE
    THEN
        kk := kk + 1 ||
        cv := cv + cw + 1 ||
        cw := cw + 2
    END
END
