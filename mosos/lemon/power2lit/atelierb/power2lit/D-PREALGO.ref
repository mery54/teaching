/* D-PREALGO: extracted from the literate model power2lit.tex
*/
/* D-PREALGO: generated by rodin2ab from the Rodin machine D-PREALGO */
REFINEMENT D-PREALGO
REFINES C-COMPUTING
SEES
    A-C0
ABSTRACT_VARIABLES
    rr,
    vv,
    kk,
    cv,
    ww,
    cw,
    ok,
    nn
INVARIANT
    /* inv2 */
    cv : INTEGER &
    /* inv5 */
    cv = vv(kk) &
    /* inv6 */
    cw : INTEGER &
    /* inv7 */
    cw = ww(kk)
ASSERTIONS
    /* propk */
    kk : (0 .. nn) &
    /* thw */
    cw = (2 * kk) &
    /* thv */
    cv = (kk * kk) &
    /* thvw */
    (4 * cv) = (cw * cw)
VARIANT
    nn - kk
INITIALISATION
        rr := r0 ||
        vv := {0 |-> 0} ||
        kk := 0 ||
        cv := 0 ||
        ww := {0 |-> 0} ||
        cw := 0 ||
        ok := FALSE ||
        nn := n0
EVENTS
    computing =
    SELECT
        /* grd1 */
        kk = nn &
        /* grd2 */
        ok = FALSE
    THEN
        rr := cv ||
        ok := TRUE
    END;

    /* step: convergent event */
    step =
    SELECT
        /* grd1 */
        kk < nn &
        /* grd2 */
        ok = FALSE
    THEN
        vv(kk + 1) := vv(kk) + ww(kk) + 1 ||
        kk := kk + 1 ||
        cv := cv + cw + 1 ||
        ww(kk + 1) := ww(kk) + 2 ||
        cw := cw + 2
    END
END
