/* C-COMPUTING: extracted from the literate model power2lit.tex
*/
/* C-COMPUTING: generated by rodin2ab from the Rodin machine C-COMPUTING */
REFINEMENT C-COMPUTING
REFINES B-PREPOST
SEES
    A-C0
ABSTRACT_VARIABLES
    rr,
    vv,
    kk,
    ww,
    ok,
    nn
INVARIANT
    /* inv1 */
    vv : (NATURAL +-> INTEGER) &
    /* inv2 */
    ww : (NATURAL +-> INTEGER) &
    /* inv3 */
    kk : NATURAL &
    /* inv4 */
    (!ii.(ii : dom(vv) => (vv(ii) = v_1(ii)))) &
    /* inv5 */
    (!ii.(ii : dom(ww) => (ww(ii) = w_1(ii)))) &
    /* inv6 */
    dom(vv) = (0 .. kk) &
    /* inv7 */
    dom(ww) = (0 .. kk) &
    /* inv8 */
    kk <= nn &
    /* inv11 */
    ((kk < nn) => (ok = FALSE))
ASSERTIONS
    /* safe1 */
    (!ii.(ii : dom(vv) => (vv(ii) = (ii * ii)))) &
    /* safe2 */
    (!ii.(ii : dom(ww) => (ww(ii) = (2 * ii))))
VARIANT
    nn - kk
INITIALISATION
        rr := r0 ||
        vv := {0 |-> 0} ||
        ww := {0 |-> 0} ||
        kk := 0 ||
        ok := FALSE ||
        nn := n0
EVENTS
    computing =
    SELECT
        /* grd1 */
        nn : dom(vv) &
        /* grd2 */
        ok = FALSE
    THEN
        rr := vv(nn) ||
        ok := TRUE
    END;

    /* step: convergent event */
    step =
    SELECT
        /* grd1 */
        nn /: dom(vv) &
        /* grd2 */
        ok = FALSE
    THEN
        vv(kk + 1) := vv(kk) + ww(kk) + 1 ||
        kk := kk + 1 ||
        ww(kk + 1) := ww(kk) + 2
    END
END
