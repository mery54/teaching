/* B-PREPOST: extracted from the literate model power2lit.tex
   Requirements taken into account:
     FUN-3 (computing.act1): Le calcul est modélisé dans la machine \textsf{PREPOST} par un événement computing qui observe la fonction calculant une valeur par l'appel d'une fonction cachée.
     FUN-2 (computing.act1): Le résultat r de cette fonction contient la valeur n0∗n0 en fin de calcul.
*/
/* B-PREPOST: generated by rodin2ab from the Rodin machine B-PREPOST */
SYSTEM
    B-PREPOST
SEES
    A-C0
ABSTRACT_VARIABLES
    rr,
    ok,
    nn
INVARIANT
    /* inv1 */
    rr : INTEGER &
    /* inv4 */
    nn : INTEGER &
    /* inv2 */
    ok : BOOL &
    /* inv3 */
    ((ok = TRUE) => (rr = (n0 * n0))) &
    /* inv5 */
    nn = n0
INITIALISATION
        rr := r0 ||
        ok := FALSE ||
        nn := n0
EVENTS
    computing =
    SELECT
        /* LSEgrd1 */
        ok = FALSE
    THEN
        rr := v_1(nn) ||
        ok := TRUE
    END
END
