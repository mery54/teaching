/* F-ALGOPC: extracted from the literate model power2lit.tex
*/
/* F-ALGOPC: generated by rodin2ab from the Rodin machine F-ALGOPC */
REFINEMENT F-ALGOPC
REFINES E-ALGO
SEES
    A-C0
ABSTRACT_VARIABLES
    rr,
    kk,
    cv,
    cw,
    pc,
    nn
INVARIANT
    /* inv1 */
    pc : LL &
    /* inv2 */
    ((pc = end) => (rr = v_1(nn))) &
    /* inv3 */
    ((pc = start) <=> (ok = FALSE)) &
    /* inv4 */
    ((pc = end) <=> (ok = TRUE))
ASSERTIONS
    /* th1 */
    cw = (2 * kk) &
    /* th2 */
    cv = (kk * kk) &
    /* th3 */
    (4 * cv) = (cw * cw)
VARIANT
    nn - kk
INITIALISATION
        rr := r0 ||
        kk := 0 ||
        cv := 0 ||
        cw := 0 ||
        pc := start ||
        nn := n0
EVENTS
    computing =
    SELECT
        /* grd1 */
        kk = nn &
        /* grd2 */
        pc = start
    THEN
        rr := cv ||
        pc := end
    END;

    /* step: convergent event */
    step =
    SELECT
        /* grd1 */
        kk < nn &
        /* grd2 */
        pc = start
    THEN
        kk := kk + 1 ||
        cv := cv + cw + 1 ||
        cw := cw + 2
    END
END
